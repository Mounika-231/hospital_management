<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data noupdate="1">

        <record id="ir_cron_appointment_reminder"
                model="ir.cron">

            <field name="name">Appointment Reminder Email</field>

            <field name="model_id"
                   ref="model_hospital_appointment"/>

            <field name="state">code</field>

            <field name="code">
model.send_appointment_reminder()
            </field>

            <field name="interval_number">1</field>

            <field name="interval_type">hours</field>

            <field name="numbercall">-1</field>

            <field name="active">True</field>

        </record>

    </data>

</odoo>