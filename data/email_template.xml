<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="email_template_appointment_reminder"
                model="mail.template">

            <field name="name">Appointment Reminder</field>

            <field name="model_id"
                   ref="model_hospital_appointment"/>

            <field name="subject">Appointment Reminder - {{ object.name }}</field>

            <field name="email_from">your_email@gmail.com</field>

            <field name="email_to">{{ object.patient_id.email }}</field>

            <field name="body_html" type="html">

                <div>

                    <p>
                        Dear <t t-out="object.patient_id.name"/>,
                    </p>

                    <p>
                        This is a reminder for your appointment.
                    </p>

                    <ul>

                        <li>
                            Appointment No:
                            <t t-out="object.name"/>
                        </li>

                        <li>
                            Doctor:
                            <t t-out="object.doctor_id.name"/>
                        </li>

                        <li>
                            Date:
                            <t t-out="object.appointment_date"/>
                        </li>

                    </ul>

                    <p>
                        Thank You.
                    </p>

                </div>

            </field>

        </record>

    </data>
</odoo>

