<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= APPOINTMENT REPORT ================= -->

    <record id="action_appointment_report" model="ir.actions.report">

        <field name="name">Appointment Slip</field>

        <field name="model">hospital.appointment</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">hospital_management.appointment_slip_template</field>

        <field name="report_file">hospital_management.appointment_slip_template</field>

        <field name="print_report_name">
            'Appointment - %s' % (object.patient_id.name)
        </field>

        <field name="binding_model_id" ref="model_hospital_appointment"/>

        <field name="binding_type">report</field>

    </record>


    <!-- ================= PATIENT CONTRACT REPORT ================= -->

    <record id="action_patient_report" model="ir.actions.report">

        <field name="name">Patient Contract Report</field>

        <field name="model">hospital.patient.problem</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">hospital_management.patient_contract_template</field>

        <field name="report_file">hospital_management.patient_contract_template</field>

        <field name="print_report_name">
            'Patient Report - %s' % (object.problem_name)
        </field>

        <field name="binding_model_id" ref="model_hospital_patient_problem"/>

        <field name="binding_type">report</field>

    </record>

</odoo>