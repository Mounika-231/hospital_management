<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- TREE VIEW -->

    <record id="patient_problem_tree" model="ir.ui.view">

        <field name="name">hospital.patient.problem.tree</field>

        <field name="model">hospital.patient.problem</field>

        <field name="arch" type="xml">

            <tree>

                <field name="patient_id"/>

                <field name="problem_name"/>

                <field name="start_date"/>

            </tree>

        </field>

    </record>


    <!-- FORM VIEW -->

    <record id="patient_problem_form" model="ir.ui.view">

        <field name="name">hospital.patient.problem.form</field>

        <field name="model">hospital.patient.problem</field>

        <field name="arch" type="xml">

            <form string="Patient Problem">

                <header>

                    <button name="%(action_patient_report)d"
                            string="Print PDF"
                            type="action"
                            class="btn-primary"/>

                </header>

                <sheet>

                    <div class="oe_title">

                        <h1>

                            <field name="problem_name"
                                   placeholder="Enter Problem"/>

                        </h1>

                    </div>

                    <group string="Patient Details">

                        <group>

                            <field name="patient_id"/>

                            <field name="start_date"/>

                        </group>

                    </group>

                    <group string="Claims Notes">

                        <field name="claim_notes"
                               placeholder="Enter claims or notes here..."/>

                    </group>

                    <group string="Bank Details">

                        <group>

                            <field name="bank_name"/>

                            <field name="account_number"/>

                            <field name="ifsc_code"/>

                        </group>

                    </group>

                    <group string="Doctor Signature">

                        <field name="doctor_sign"
                               widget="image"
                               class="oe_avatar"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ACTION -->

    <record id="action_patient_problem" model="ir.actions.act_window">

        <field name="name">Patient Problems</field>

        <field name="res_model">hospital.patient.problem</field>

        <field name="view_mode">tree,form</field>

    </record>


    <!-- MENU -->

    <menuitem
        id="menu_patient_problem"
        name="Patient Problems"
        parent="hospital_root"
        action="action_patient_problem"
        sequence="4"/>

</odoo>